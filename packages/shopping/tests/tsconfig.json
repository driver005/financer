{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "../.test-build",
    "rootDir": "../../..",
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "dom"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "../src/api/*.ts",
    "../src/logic/*.ts",
    "./*.test.ts",
    "../../wire/src/index.ts",
    "../../wire/src/logic.ts",
    "../../../apps/sdk-bindings/src/generated-web/index.ts",
    "../../../apps/sdk-bindings/src/generated-web/financer_sdk_bg.js"
  ]
}
