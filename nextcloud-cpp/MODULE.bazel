module(
    name = "nextcloud_cpp",
    version = "0.1.0",
)

# Same rule set as congelado. Its patch of rules_cc for the C++ modules build variables is not carried
# over: this tree builds with plain headers (see docs/architecture.md, "Toolchain").
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.0.0")

# SQLite for the database plugin (amalgamation from the Bazel registry, compiled with the toolchain below).
bazel_dep(name = "sqlite3", version = "3.49.1.bcr.1")

# TLS for the HTTP server (BoringSSL builds with plain Bazel rules, no foreign build needed).
bazel_dep(name = "boringssl", version = "0.20240930.0")

third_party_deps = use_extension("//third_party:extension.bzl", "third_party_deps")
use_repo(third_party_deps, "system_cc")

register_toolchains("//bazel/toolchain/system_cc:system_clang_toolchain")

# SFTP for external storage (libssh2; the crypto backend is mbedTLS, set in .bazelrc).
bazel_dep(name = "libssh2", version = "1.11.1.bcr.2")
