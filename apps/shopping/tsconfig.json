{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/shopping/src/**/*.ts",
    "../../packages/shopping/src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "../../packages/shopping/node_modules",
    "../../packages/shopping/.test-build"
  ]
}
