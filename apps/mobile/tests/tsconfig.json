{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "../.test-build",
    "rootDir": "..",
    "types": ["node"],
    "lib": ["es2022", "dom"]
  },
  "include": [
    "../src/lib/types.ts",
    "../src/lib/period.ts",
    "../src/lib/money.ts",
    "../src/lib/csv.ts",
    "../src/lib/stores.ts",
    "../src/lib/provider.ts",
    "./*.test.ts"
  ]
}
