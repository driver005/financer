{
  "name": "financer-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "expo": "~58.0.17",
    "expo-background-task": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.8",
    "expo-font": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.11",
    "expo-web-browser": "~58.0.6",
    "heroui-native": "^1.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "gen:api": "(cd ../.. && cargo run -q -p financer-server -- --print-openapi) > openapi.json && npx --yes openapi-typescript@7.13.0 openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tests/tsconfig.json && node --test \".test-build/tests/*.test.js\" \"tests/*.test.mjs\""
  },
  "private": true,
  "overrides": {
    "react-native-reanimated": {
      "react-native": "$react-native"
    },
    "react-native-worklets": {
      "react-native": "$react-native"
    },
    "heroui-native": {
      "react-native": "$react-native",
      "react-native-gesture-handler": "$react-native-gesture-handler"
    },
    "uniwind": {
      "react-native": "$react-native"
    }
  }
}
