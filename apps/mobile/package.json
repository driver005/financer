{
  "name": "financer-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "gen:api": "(cd ../.. && cargo run -q -p financer-server -- --print-openapi) > openapi.json && npx --yes openapi-typescript@7.13.0 openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tests/tsconfig.json && node --test \".test-build/tests/*.test.js\""
