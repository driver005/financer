{
  "expo": {
    "name": "Pantry",
    "slug": "pantry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pantry.mobile"
    },
    "android": {
      "package": "app.pantry.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pantry",
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      "expo-image-picker",
      ["expo-local-authentication", { "faceIDPermission": "Pantry uses Face ID to unlock your local data." }],
      ["./plugins/withQuickAddShortcut.js"]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
