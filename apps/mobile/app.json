{
  "expo": {
    "name": "Financer",
    "slug": "financer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.financer.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.financer.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "com.lidlplus.app",
              "host": "callback"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "financer",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Financer uses Face ID to unlock the app when you have turned on the app lock."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Financer uses the camera to photograph receipts so it can learn what you usually buy.",
          "photosPermission": "Financer reads receipt photos you choose so it can learn what you usually buy."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Financer uses the camera to scan product barcodes in the store.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Financer uses Face ID to lock the app, which holds your bank data."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
