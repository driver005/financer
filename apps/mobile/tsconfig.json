{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@finance/ui": [
        "../../packages/finance-ui/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/finance-ui/src/**/*.ts",
    "../../packages/finance-ui/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "tests",
    ".test-build",
    "dist"
  ]
}
