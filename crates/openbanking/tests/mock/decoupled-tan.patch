+/// The TAN process of an HKTAN segment: `4` (start), `S` (poll), `2` (submit TAN), ...
+fn hktan_process(message: &[u8]) -> Option<String> {
+    let prefix = b"HKTAN:";
+    let pos = message.windows(prefix.len()).position(|w| w == prefix)?;
+    let seg = &message[pos..];
+    let end = seg.iter().position(|&b| b == b'\'')?;
+    let text = std::str::from_utf8(&seg[..end]).ok()?;
+    text.split('+').nth(1).map(str::to_string)
+}
