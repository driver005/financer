{
  "id": "smartphone",
  "name": "Smartphone",
  "extends": "generic",
  "keywords": ["smartphone", "handy", "phone", "mobiltelefon", "iphone", "galaxy", "pixel"],
  "tiers": ["budget", "mid-range", "upper mid-range", "flagship"],
  "attributes": [
    {"key": "os", "label": "Operating system", "kind": "text", "aliases": ["Betriebssystem", "OS"]},
    {"key": "ecosystem", "label": "Ecosystem", "kind": "list", "aliases": ["Ökosystem"]},
    {"key": "screen_inches", "label": "Screen size", "unit": "in", "aliases": ["Bildschirmdiagonale", "Displaygröße", "Display size", "Screen"]},
    {"key": "display_refresh_hz", "label": "Refresh rate", "unit": "Hz", "aliases": ["Bildwiederholrate", "Display refresh rate"]},
    {"key": "battery_mah", "label": "Battery", "unit": "mAh", "aliases": ["Akkukapazität", "Akku", "Battery capacity"]},
    {"key": "charge_watts", "label": "Charging speed", "unit": "W", "aliases": ["Ladeleistung", "Schnellladen", "Charging power", "Fast charging"]},
    {"key": "wireless_charging", "label": "Wireless charging", "kind": "bool", "aliases": ["Kabelloses Laden", "Induktives Laden"]},
    {"key": "ram_gb", "label": "RAM", "unit": "GB", "aliases": ["Arbeitsspeicher", "RAM-Speicher", "Memory"], "units": {"gb": 1, "mb": 0.001}},
    {"key": "storage_gb", "label": "Storage", "unit": "GB", "aliases": ["Speicher", "Interner Speicher", "Speicherkapazität", "Internal storage"], "units": {"tb": 1000, "gb": 1}},
    {"key": "main_camera_mp", "label": "Main camera", "unit": "MP", "aliases": ["Hauptkamera", "Kamera Auflösung", "Main camera resolution"]},
    {"key": "camera_score", "label": "Camera test score", "aliases": ["Kamerabewertung", "DXOMARK", "Camera score"]},
    {"key": "geekbench_multi", "label": "Geekbench multi-core", "aliases": ["Geekbench", "Benchmark", "Geekbench 6"]},
    {"key": "weight_g", "label": "Weight", "unit": "g", "aliases": ["Gewicht"]},
    {"key": "water_resistance", "label": "Water resistance", "kind": "text", "aliases": ["Schutzklasse", "Wasserdicht", "IP-Zertifizierung", "IP rating"]},
    {"key": "five_g", "label": "5G", "kind": "bool", "aliases": ["5G-fähig", "5G Support"]},
    {"key": "nfc", "label": "NFC", "kind": "bool", "aliases": ["NFC-Chip", "Kontaktloses Bezahlen"]},
    {"key": "esim", "label": "eSIM", "kind": "bool", "aliases": ["eSIM-fähig"]},
    {"key": "update_years", "label": "Software updates", "unit": "years", "aliases": ["Update-Garantie", "Updates bis", "Software support", "Update years"]},
    {"key": "expandable_storage", "label": "Memory card slot", "kind": "bool", "aliases": ["microSD", "Speicherkarte", "Speichererweiterung"]},
    {"key": "headphone_jack", "label": "Headphone jack", "kind": "bool", "aliases": ["Klinkenanschluss", "3,5mm Klinke"]}
  ],
  "derive": [
    {"attribute": "ecosystem", "from": "os", "contains": "android", "add": ["android"]},
    {"attribute": "ecosystem", "from": "os", "contains": "ios", "add": ["apple"]},
    {"attribute": "ecosystem", "from": "brand", "contains": "apple", "add": ["apple"]},
    {"attribute": "ecosystem", "from": "brand", "contains": "samsung", "add": ["samsung"]},
    {"attribute": "ecosystem", "from": "brand", "contains": "google", "add": ["google"]},
    {"attribute": "ecosystem", "from": "brand", "contains": "xiaomi", "add": ["xiaomi"]},
    {"attribute": "ecosystem", "from": "title", "contains": "iphone", "add": ["apple"]},
    {"attribute": "ecosystem", "from": "title", "contains": "galaxy", "add": ["android", "samsung"]},
    {"attribute": "ecosystem", "from": "title", "contains": "pixel", "add": ["android", "google"]}
  ],
  "criteria": [
    {"key": "performance", "label": "Performance", "kind": "number", "attribute": "geekbench_multi", "weight": 2, "scale": {"type": "fixed", "min": 1500, "max": 9000}, "group": "speed"},
    {"key": "camera", "label": "Camera", "kind": "formula", "expr": "clamp(coalesce(camera_score, 55 + main_camera_mp / 10), 0, 100)", "weight": 2, "scale": {"type": "fixed", "min": 50, "max": 100}, "group": "camera"},
    {"key": "battery", "label": "Battery", "kind": "number", "attribute": "battery_mah", "weight": 2, "scale": {"type": "fixed", "min": 3000, "max": 6500}, "group": "battery"},
    {"key": "charging", "label": "Charging speed", "kind": "number", "attribute": "charge_watts", "weight": 1, "scale": {"type": "fixed", "min": 15, "max": 100}, "group": "battery"},
    {"key": "display", "label": "Display smoothness", "kind": "number", "attribute": "display_refresh_hz", "weight": 1, "scale": {"type": "fixed", "min": 60, "max": 144}, "group": "display"},
    {"key": "storage", "label": "Storage", "kind": "number", "attribute": "storage_gb", "weight": 1, "log": true, "scale": {"type": "fixed", "min": 64, "max": 1024}, "group": "memory"},
    {"key": "ram", "label": "RAM", "kind": "number", "attribute": "ram_gb", "weight": 1, "scale": {"type": "fixed", "min": 4, "max": 16}, "group": "memory"},
    {"key": "updates", "label": "Software updates", "description": "Years of security and OS updates", "kind": "number", "attribute": "update_years", "weight": 2, "scale": {"type": "fixed", "min": 2, "max": 7}, "group": "longevity"},
    {"key": "recency", "label": "Newness", "kind": "age", "attribute": "released", "half_life_months": 24, "weight": 1, "group": "longevity"},
    {"key": "ecosystem", "label": "Fits my ecosystem", "description": "Matches the ecosystem you prefer (watch, earbuds, family)", "kind": "match", "attribute": "ecosystem", "preference": "ecosystem", "weight": 2, "group": "fit"},
    {"key": "water", "label": "Water resistance", "kind": "choice", "attribute": "water_resistance", "scores": {"ip68": 1.0, "ip69": 1.0, "ip67": 0.85, "ip66": 0.7, "ip65": 0.6, "ip54": 0.4, "ip53": 0.3}, "default": 0.0, "weight": 0.5, "group": "build"},
    {"key": "weight", "label": "Light weight", "kind": "number", "attribute": "weight_g", "higher_is_better": false, "weight": 0.5, "scale": {"type": "fixed", "min": 140, "max": 250}, "group": "build"},
    {"key": "five_g", "label": "5G", "kind": "flag", "attribute": "five_g", "weight": 0.5, "group": "connectivity"}
  ]
}
