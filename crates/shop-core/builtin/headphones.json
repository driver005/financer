    {"key": "battery", "label": "Battery life", "kind": "number", "attribute": "battery_hours", "weight": 1.5, "scale": {"type": "fixed", "min": 4, "max": 60}},
    {"key": "multipoint", "label": "Multipoint", "kind": "flag", "attribute": "multipoint", "weight": 0.5},
    {"key": "weight", "label": "Light weight", "kind": "number", "attribute": "weight_g", "higher_is_better": false, "weight": 0.5, "scale": {"type": "fixed", "min": 4, "max": 350}},
    {"key": "ecosystem", "label": "Fits my ecosystem", "kind": "match", "attribute": "ecosystem", "preference": "ecosystem", "weight": 1.5}
  ]
