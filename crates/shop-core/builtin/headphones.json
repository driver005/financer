{
  "id": "headphones",
  "name": "Headphones",
  "extends": "generic",
  "keywords": ["headphones", "kopfhörer", "earbuds", "airpods", "in-ear"],
  "attributes": [
    {"key": "kind", "label": "Type", "kind": "text", "aliases": ["Bauform", "Typ"]},
    {"key": "anc", "label": "Noise cancelling", "kind": "bool", "aliases": ["Noise Cancelling", "ANC", "Geräuschunterdrückung"]},
    {"key": "battery_hours", "label": "Battery life", "unit": "h", "aliases": ["Akkulaufzeit", "Laufzeit", "Playtime"]},
    {"key": "multipoint", "label": "Multipoint", "kind": "bool", "aliases": ["Multipoint-Verbindung"]},
    {"key": "review_score", "label": "Sound review score", "aliases": ["Klangbewertung", "Testnote", "Sound score"]},
    {"key": "weight_g", "label": "Weight", "unit": "g", "aliases": ["Gewicht"]},
    {"key": "ecosystem", "label": "Ecosystem", "kind": "list"}
  ],
  "derive": [
    {"attribute": "ecosystem", "from": "brand", "contains": "apple", "add": ["apple"]},
    {"attribute": "ecosystem", "from": "brand", "contains": "samsung", "add": ["samsung"]},
    {"attribute": "ecosystem", "from": "brand", "contains": "google", "add": ["google"]}
