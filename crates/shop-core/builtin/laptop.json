    {"key": "display", "label": "Display brightness", "kind": "number", "attribute": "display_nits", "weight": 1, "scale": {"type": "fixed", "min": 250, "max": 600}},
    {"key": "weight", "label": "Light weight", "kind": "number", "attribute": "weight_kg", "higher_is_better": false, "weight": 1, "scale": {"type": "fixed", "min": 1.0, "max": 2.5}},
    {"key": "recency", "label": "Newness", "kind": "age", "attribute": "released", "half_life_months": 30, "weight": 0.5},
    {"key": "ecosystem", "label": "Fits my ecosystem", "kind": "match", "attribute": "ecosystem", "preference": "ecosystem", "weight": 1.5}
